# Copy this file into the artworkers.online release worktree as mode 0600.
# It is non-secret build and routing metadata. R2 credentials stay in New API.
DOMAIN=artworkers.online
VITE_BASE=/canvas/
VITE_FIXED_API_BASE_URL=https://artworkers.online
VITE_DOCS_URL=https://artworkers.online/image/manual/index.html
CANVAS_PUBLIC_PATH=/canvas/canvas
CANVAS_BLUE_PORT=3431
CANVAS_GREEN_PORT=3432
UPLOADS_BLUE_PORT=3440
UPLOADS_GREEN_PORT=3441
CANVAS_NGINX_SNIPPET=/etc/nginx/snippets/artworkers-online-canvas.conf
UPLOADS_NGINX_SNIPPET=/etc/nginx/snippets/artworkers-online-canvas-uploads.conf
